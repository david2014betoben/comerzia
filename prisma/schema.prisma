// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  CAJERO
  CLIENTE
}

enum TipoMovimiento {
  INGRESO
  VENTA_POS
  PEDIDO_WEB
  DEVOLUCION_PEDIDO
  AJUSTE
}

enum EstadoCarrito {
  ACTIVO
  CONVERTIDO
  ABANDONADO
}

enum EstadoSesionCaja {
  ABIERTA
  CERRADA
}

enum EstadoVenta {
  ABIERTA
  PAGADA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  QR
  PASARELA
}

enum OrigenPedido {
  WEB
  REDES_SOCIALES
}

enum EstadoPedido {
  PENDIENTE
  PAGADO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

model Usuario {
  id           Int        @id @default(autoincrement())
  nombre       String     @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  passwordHash String     @db.VarChar(255)
  rol          RolUsuario @default(CLIENTE)
  telefono     String?    @db.VarChar(30)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  direcciones      Direccion[]
  carritos         Carrito[]
  sesionesCaja     SesionCaja[]
  movimientosStock MovimientoInventario[]
  pedidos          Pedido[]

  @@map("usuarios")
}

model Direccion {
  id           Int     @id @default(autoincrement())
  usuarioId    Int
  alias        String  @db.VarChar(50)
  destinatario String  @db.VarChar(100)
  telefono     String  @db.VarChar(30)
  ciudad       String  @db.VarChar(80)
  direccion    String  @db.VarChar(200)
  referencias  String?
  esPrincipal  Boolean @default(false)

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@index([usuarioId])
  @@map("direcciones")
}

model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(80)
  descripcion String?
  activa      Boolean @default(true)

  productos Producto[]

  @@map("categorias")
}

model Producto {
  id          Int      @id @default(autoincrement())
  categoriaId Int
  sku         String   @unique @db.VarChar(50)
  nombre      String   @db.VarChar(120)
  descripcion String?
  costoCompra Decimal  @db.Decimal(10, 2)
  precioVenta Decimal  @db.Decimal(10, 2)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  categoria       Categoria              @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  inventario      Inventario?
  movimientos     MovimientoInventario[]
  detallesCarrito DetalleCarrito[]
  detallesVenta   DetalleVenta[]
  detallesPedido  DetallePedido[]

  @@index([categoriaId])
  @@map("productos")
}

model Inventario {
  productoId Int      @id
  stock      Int      @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@map("inventario")
}

model MovimientoInventario {
  id         Int            @id @default(autoincrement())
  productoId Int
  usuarioId  Int?
  ventaId    Int?
  pedidoId   Int?
  tipo       TipoMovimiento
  cantidad   Int
  motivo     String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  usuario  Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  venta    Venta?   @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  pedido   Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  @@index([productoId, createdAt])
  @@index([ventaId])
  @@index([pedidoId])
  @@map("movimientos_inventario")
}

model Carrito {
  id        Int           @id @default(autoincrement())
  usuarioId Int
  estado    EstadoCarrito @default(ACTIVO)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  usuario  Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  detalles DetalleCarrito[]

  @@index([usuarioId, estado])
  @@map("carritos")
}

model DetalleCarrito {
  id         Int @id @default(autoincrement())
  carritoId  Int
  productoId Int
  cantidad   Int

  carrito  Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([carritoId, productoId])
  @@map("detalles_carrito")
}

model SesionCaja {
  id               Int              @id @default(autoincrement())
  cajeroId         Int
  estado           EstadoSesionCaja @default(ABIERTA)
  montoInicial     Decimal          @db.Decimal(10, 2)
  efectivoContado  Decimal?         @db.Decimal(10, 2)
  efectivoEsperado Decimal?         @db.Decimal(10, 2)
  diferencia       Decimal?         @db.Decimal(10, 2)
  abiertaEn        DateTime         @default(now()) @db.Timestamptz(3)
  cerradaEn        DateTime?        @db.Timestamptz(3)

  cajero Usuario @relation(fields: [cajeroId], references: [id], onDelete: Restrict)
  ventas Venta[]

  @@index([cajeroId, estado])
  @@map("sesiones_caja")
}

model Venta {
  id                Int         @id @default(autoincrement())
  sesionCajaId      Int
  numeroComprobante String      @unique @db.VarChar(40)
  estado            EstadoVenta @default(ABIERTA)
  metodoPago        MetodoPago?
  total             Decimal     @default(0) @db.Decimal(10, 2)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  sesionCaja            SesionCaja             @relation(fields: [sesionCajaId], references: [id], onDelete: Restrict)
  detalles              DetalleVenta[]
  movimientosInventario MovimientoInventario[]

  @@index([sesionCajaId, createdAt])
  @@map("ventas")
}

model DetalleVenta {
  id             Int     @id @default(autoincrement())
  ventaId        Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  costoUnitario  Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([ventaId, productoId])
  @@map("detalles_venta")
}

model Pedido {
  id               Int          @id @default(autoincrement())
  usuarioId        Int?
  direccionId      Int?
  origen           OrigenPedido @default(WEB)
  estado           EstadoPedido @default(PENDIENTE)
  destinatario     String       @db.VarChar(100)
  telefonoDestino  String       @db.VarChar(30)
  ciudadDestino    String       @db.VarChar(80)
  direccionDestino String       @db.VarChar(200)
  referencias      String?
  totalProductos   Decimal      @db.Decimal(10, 2)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  usuario               Usuario?               @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  direccion             Direccion?             @relation(fields: [direccionId], references: [id], onDelete: SetNull)
  detalles              DetallePedido[]
  pagos                 Pago[]
  movimientosInventario MovimientoInventario[]

  @@index([usuarioId, createdAt])
  @@index([estado, createdAt])
  @@map("pedidos")
}

model DetallePedido {
  id             Int     @id @default(autoincrement())
  pedidoId       Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  costoUnitario  Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([pedidoId, productoId])
  @@map("detalles_pedido")
}

model Pago {
  id                  Int        @id @default(autoincrement())
  pedidoId            Int
  metodo              MetodoPago
  estado              EstadoPago @default(PENDIENTE)
  monto               Decimal    @db.Decimal(10, 2)
  proveedor           String?    @db.VarChar(80)
  referenciaProveedor String?    @unique @db.VarChar(150)
  respuestaPasarela   Json?      @db.JsonB
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  @@index([pedidoId, estado])
  @@map("pagos")
}
